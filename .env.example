# ─── Volta backend configuration ───────────────────────────────────────────
# Copy this file to `.env` and edit values for your environment.

# Server
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed origins (the Express server also serves the
# front-end itself on the same port, so same-origin requests always work).
CORS_ORIGIN=*

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# SQLite
DB_PATH=./data/volta.db

# Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# ─── Email / 2FA ───────────────────────────────────────────────────────────
# When SMTP_HOST is empty, the backend falls back to "dev mode": OTP codes are
# logged to the server console AND returned in the API response under
# `devCode` so you can see them during testing. Set SMTP credentials to send
# real emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Volta App <no-reply@volta.app>

# OTP lifetime in minutes
OTP_TTL_MINUTES=10

# If `true`, the API response always includes `devCode` (even when SMTP is
# configured). Useful for staging. Leave `false` in production.
OTP_DEV_IN_RESPONSE=true
